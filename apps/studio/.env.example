# --- Database
DATABASE_URL=postgres://tcm@127.0.0.1:5433/tcm_dev

# --- Auth (generate with: openssl rand -base64 48)
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me-change-me
# Open registration (true for hosted SaaS, false = invite-only self-host)
ALLOW_SIGNUP=true

# --- Public URLs. Multi-host (SaaS) or single-host (self-host) is inferred from these.
PUBLIC_STUDIO_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3000/api
PUBLIC_MAPS_URL=http://localhost:8081
# Set when studio/api/maps are subdomains of one parent, e.g. .example.com
# COOKIE_DOMAIN=

TCM_EDITION=selfhosted
TCM_VERSION=dev

# --- Artifact storage (fs = shared volume served by the delivery container)
ARTIFACT_STORE=fs
ARTIFACT_FS_ROOT=/absolute/path/to/.data/delivery   # absolute; shared by studio and worker

# --- Basemap (optional override; otherwise the registered basemap_versions row is used)
# BASEMAP_URL=

# --- Email (unset in dev: links are logged to the console)
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# SMTP_FROM="True Canadian Maps <no-reply@example.com>"

LOG_LEVEL=info
