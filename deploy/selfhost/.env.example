# Linux x64 preview; never use a moving image tag for a released installation.
TCM_VERSION=0.2.0
STUDIO_HOST=maps.example.com
PUBLIC_STUDIO_URL=https://maps.example.com
PUBLIC_API_URL=https://maps.example.com/api
PUBLIC_MAPS_URL=https://maps.example.com/maps
ACME_EMAIL=admin@example.com

# Optional separate map-files domain. Studio and its API share a hostname.
# CADDY_CONFIG=./Caddyfile.multi
# MAPS_HOST=tiles.example.com
# PUBLIC_MAPS_URL=https://tiles.example.com

APP_PORT=3000
DELIVERY_PORT=8081
ALLOW_SIGNUP=false
REQUIRE_EMAIL_VERIFICATION=false
PASSWORD_RECOVERY_ENABLED=false
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=

# Canada overview; detailed extracts require more disk and time.
BBOX=-141.01,41.67,-52.58,83.14
REGION=ca
BASEMAP_MAXZOOM=8
# Pin a YYYYMMDD upstream build for reproducible extraction.
BASEMAP_BUILD=

# Provision real SMTP privately before enabling password recovery.
# SMTP_URL=
# SMTP_FROM=
