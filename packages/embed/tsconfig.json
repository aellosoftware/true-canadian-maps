{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "strict": true,
    "noUncheckedIndexedAccess": true, "esModuleInterop": true,
    "isolatedModules": true, "verbatimModuleSyntax": true,
    "skipLibCheck": true, "rootDir": "src", "outDir": "dist", "noEmit": true
  },
  "include": ["src"]
}
